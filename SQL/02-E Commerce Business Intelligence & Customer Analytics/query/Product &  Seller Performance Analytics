--Q4. Seller Revenue Performance

WITH Revenue_by_sellers_info AS (
SELECT OI.order_id,
OI.product_id,
OI.seller_id,
OI.price,
S.seller_city,
S.seller_state
FROM order_item_dataset AS OI
LEFT JOIN sellers_Dataset AS S
ON S.seller_id = OI.seller_id)

SELECT Seller_id,
Seller_city,
seller_state,
SUM(price) AS total_revenue,
ROUND(SUM(price)/ (SELECT SUM(price) FROM revenue_by_sellers_info)*100 ,2) AS percentage
FROM revenue_by_Sellers_info
GROUP BY seller_id, seller_city, seller_state
ORDER BY total_revenue DESC;



--Business Interpretation.
--Output shows the majority of the top 10 sellers from the SP state.
-- Around 10% revenue generated by these top 10 sellers
--Not much huge skew between these sellers. average 0.3% revenue are difference


