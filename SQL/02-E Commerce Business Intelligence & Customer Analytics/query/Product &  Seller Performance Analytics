--Q6. Seller Average item Price


WITH Revenue_by_sellers_info AS (
SELECT OI.order_id,
OI.product_id,
OI.seller_id,
OI.price,
S.seller_city,
S.seller_state
FROM order_item_dataset AS OI
LEFT JOIN sellers_Dataset AS S
ON S.seller_id = OI.seller_id)

SELECT Seller_id,
Seller_city,
seller_state,
ROUND(AVG(price),2) AS average_item_price,
COUNT(order_id) AS order_count
FROM revenue_by_Sellers_info
GROUP BY seller_id, seller_city, seller_state
HAVING COUNT(order_id)>=10
ORDER BY  average_item_price DESC;

--Business Interpretation  : Output shows the highest average price is 2025.50 from the SP state
--2. It is evident that the cost of the product generate the average price per seller.
--3. It also shows that top 5 seller completed very few orders but they generated more revenue due to the product is expensive.


