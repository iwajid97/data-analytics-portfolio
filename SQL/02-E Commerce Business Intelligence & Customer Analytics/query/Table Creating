--Creating the respective tables


--1. Customer dataset table (DIM)

CREATE TABLE customer_dataset (
    customer_id VARCHAR(100) PRIMARY KEY,
    customer_unique_id VARCHAR(100),
    customer_zip_code_prefix VARCHAR(50),
    customer_city VARCHAR(50),
	customer_state VARCHAR(10)
);

--INFO of each columns
SELECT *
FROM information_schema.columns
WHERE table_name = 'customer_dataset'

--2. geolocation table (DIM)

CREATE TABLE geolocation_dataset (
	geolocation_zip_code_prefix INT,
	geolocation_lat NUMERIC(10,6),
	geolocation_lng NUMERIC(10,6),
	geolocation_city VARCHAR(100),
	geolocation_state VARCHAR(10)
);

--INFO of each columns
SELECT *
FROM information_schema.columns
WHERE table_name = 'geolocation_dataset'


--3. order_item_dataset (FACT)

CREATE TABLE order_item_dataset (
	order_id VARCHAR(50),
	order_item_id INT,
	product_id VARCHAR(50),
	seller_id VARCHAR(50),
	shipping_limit_date TIMESTAMP,
	price NUMERIC(10,2),
	freight_value NUMERIC(10,2)
);


--INFO of each columns
