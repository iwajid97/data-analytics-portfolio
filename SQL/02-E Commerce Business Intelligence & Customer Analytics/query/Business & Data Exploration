--Task-6 Customer Order Activity

--Q1. How many orders has each customer placed?

WITH customers_with_order AS (
SELECT O.order_id,
O.customer_id,
C.customer_unique_id
FROM orders_dataset AS O
LEFT JOIN customer_Dataset AS C
ON C.customer_id = O.customer_id
ORDER BY customer_unique_id)

SELECT Customer_unique_id,
COUNT(order_id) AS total_orders
FROM customers_with_order
GROUP BY customer_unique_id;


--Task-7 - High Frequency Customers

WITH customers_with_order AS (
SELECT O.order_id,
O.customer_id,
C.customer_unique_id
FROM orders_dataset AS O
LEFT JOIN customer_Dataset AS C
ON C.customer_id = O.customer_id
ORDER BY customer_unique_id)

SELECT Customer_unique_id,
COUNT(order_id) AS total_orders
FROM customers_with_order
GROUP BY customer_unique_id
HAVING COUNT(order_id) > 3
ORDER BY total_orders DESC;


