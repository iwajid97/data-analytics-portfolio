-- Customer Retention & Repeat Purchase Analytics

--Q1. Repeat Customer Identification

WITH Customer_purchase_Dataset AS (
SELECT O.customer_id,
O.order_id,
O.order_status,
C.customer_unique_id,
O.order_purchase_timestamp
FROM orders_dataset AS O
LEFT JOIN customer_dataset AS C
ON O.customer_id = C.customer_id
WHERE O.order_status = 'delivered')


SELECT customer_unique_id,
COUNT(order_id) AS total_orders,
MAX(order_purchase_timestamp:: DATE) AS Most_Recent_purchase,
MIN(order_purchase_timestamp:: DATE) AS First_purchase
FROM customer_purchase_Dataset
GROUP BY customer_unique_id
HAVING COUNT(order_id) > 1
ORDER BY total_orders DESC
LIMIT 20;

-- Business Interpretation: The top customer 15 orders purchased and it was between aug 2018 and jun 2017
--20th place customer with 4 orders and first purchase happened on mar 2018 and the latest purchase is recorded on 2018 june.


--Q2. Repeat Customer Rate

WITH Customers_order AS (
SELECT O.order_id,
O.customer_id,
C.customer_unique_id,
O.order_status
FROM orders_dataset AS O
LEFT JOIN customer_dataset AS C
ON C.customer_id = O.customer_id
WHERE order_status = 'delivered'),

Customer_summary AS (
SELECT customer_unique_id,
COUNT(order_id) AS Total_orders
FROM customers_order
GROUP BY customer_unique_id)


SELECT COUNT(customer_unique_id) AS Total_unique_customers,
COUNT(customer_unique_id) FILTER( WHERE Total_orders = 1) AS One_time_customer,
COUNT(customer_unique_id) FILTER( WHERE Total_orders > 1) AS Repeated_Customer,
COUNT(customer_unique_id) FILTER( WHERE Total_orders > 1)*100.0 / COUNT(customer_unique_id)AS Repeated_customer_rate
FROM customer_summary


--Business Interpretation: It is clearly seen in the summary report that only 3% of the customers with their unique id have purchased more than once which is 2801.
-- Total 93358 customers have purchased and 90557 which is 93% are one time purchaser.



