--Q4. Customer Lifetime Revenue


WITH Customer_salesandrevenue AS (
SELECT O.order_id,
C.customer_unique_id,
OI.price,
OI.freight_value,
O.order_status
FROM orders_dataset AS O
LEFT JOIN customer_dataset AS C
ON C.customer_id = O.customer_id
LEFT JOIN order_item_dataset AS OI
ON OI.order_id = O.order_id
WHERE O.order_status = 'delivered')

SELECT customer_unique_id,
COUNT( DISTINCT order_id) AS total_delivered_orders,
ROUND(SUM(price),2) AS total_product_revenue,
ROUND(SUM(freight_value),2) AS total_freight_cost,
ROUND(SUM(price) + SUM(freight_value),2)  AS Total_customer_value
FROM customer_salesandrevenue
GROUP BY customer_unique_id
ORDER BY Total_customer_value DESC
LIMIT 20;


-- Business Interpretation: Output shows the top 20 customers based on the customer value.
--highest 13664.08 value with total 1 orders and 10th customer with 4 orders and has average value of 4655.88


--Q5. Monthly new vs returning customers


WITH Customer_purchase_period AS (
SELECT O.order_id,
DATE_TRUNC('month',O.order_purchase_timestamp):: DATE AS Purchase_month,
C.customer_unique_id
FROM orders_dataset AS O
LEFT JOIN customer_Dataset AS C
ON C.customer_id = O.customer_id
WHERE order_status = 'delivered'),

First_purchase_month AS (
SELECT Customer_unique_id,
purchase_month,
MIN(purchase_month) AS First_purchase_month
FROM customer_purchase_period),

Purchase_type_table AS (SELECT DISTINCT CPP.customer_unique_id,CPP.purchase_month, 
CASE
	WHEN CPP.purchase_month = FPM.first_purchase_month THEN 'New' ELSE 'Returning'
END AS Purchase_type
FROM customer_purchase_period AS CPP
LEFT JOIN First_purchase_month AS FPM
ON CPP.customer_unique_id = FPM.customer_unique_id)

SELECT  purchase_month,
COUNT(*) FILTER(WHERE purchase_type = 'New') AS New_customers,
COUNT(*) FILTER(WHERE purchase_type = 'Returning') AS Returning_customers,
COUNT(customer_unique_id) AS total_Active_customers
FROM purchase_type_table
GROUP BY purchase_month
ORDER BY purchase_month


--Business Interpretation: It is evident that customer activity is increased gradually  from Jan - 2017  starts with 718 customers till 2018-Aug 6310 customers.


--Q6. Customer Revenue Segmentation

WITH Customer_salesandrevenue AS (
SELECT O.order_id,
C.customer_unique_id,
OI.price,
OI.freight_value,
O.order_status
FROM orders_dataset AS O
LEFT JOIN customer_dataset AS C
ON C.customer_id = O.customer_id
LEFT JOIN order_item_dataset AS OI
ON OI.order_id = O.order_id
WHERE O.order_status = 'delivered'),

Customers_with_revenue AS (SELECT customer_unique_id,
SUM(price) + SUM(freight_value) AS Total_revenue
FROM customer_salesandrevenue
GROUP BY customer_unique_id)

SELECT CASE
			WHEN Total_revenue <100 THEN 'Low Value'
			WHEN Total_revenue >=100 AND Total_revenue <=299.99 THEN 'Medium Value'
			WHEN Total_revenue >=300 AND Total_revenue <=599.99 THEN 'High Value'
			ELSE 'Very High Value'
		END AS Customer_Segment,
COUNT( customer_unique_id) AS Number_of_customers,
ROUND(SUM(Total_revenue),2)  AS Total_revenue_generated,
ROUND(AVG(Total_revenue),2) AS Average_Customer_Value
FROM Customers_with_revenue
GROUP BY CASE
			WHEN Total_revenue <100 THEN 'Low Value'
			WHEN Total_revenue >=100 AND Total_revenue <=299.99 THEN 'Medium Value'
			WHEN Total_revenue >=300 AND Total_revenue <=599.99 THEN 'High Value'
			ELSE 'Very High Value'
		END 


